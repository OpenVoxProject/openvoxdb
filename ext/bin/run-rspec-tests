#!/usr/bin/env bash

# Run Ruby rspec tests on Ruby code in puppet/ directory
# Requires single argument, an OpenVox version number like 8.24.2

set -uxeo pipefail

# Validate argument
test "$#" -eq 1
puppet_ref="$1"

# Log Ruby version
ruby -v
# Save OpenVox version as local test config value
ext/bin/test-config --set puppet-ref "$puppet_ref"
# The puppet directory contains the OpenVoxDB related Ruby files packaged with
# OpenVox as well as the rspec test files that test them
cd puppet
# Install Ruby dependencies from top-level Gemfile via bundle
bundle install --retry=10
# Start rspec tests
bundle exec rspec spec
