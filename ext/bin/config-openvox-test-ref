#!/usr/bin/env bash

# Modify local testing environment to use specific version of OpenVox.
# With no arguments, uses default OpenVox version
# With one argument, uses argument as OpenVox version
# Creates a symlink to bundler-installed OpenVox repo at vendor/puppet used for testing
# Ex: config-openvox-test-ref
# Ex: config-openvox-test-ref 8.24.2

set -euo pipefail

# Always run from the top-level of OpenVoxDB source tree
script_home="$(cd "$(dirname "$0")" && pwd)"
top="$script_home/../.."
cd "$top"

usage() {
    echo "Usage: $(basename "$0") [REF]"
}

# Verify bundler is installed
if test -z "$(type -t bundle)"; then
    cat 2>&1 <<-EOS
	Ruby bundler does not appear to be available.
	Please install it via "gem install --user-install bundler" or similar.
	EOS
    exit 2
fi

set -x

# Remove old OpenVox version test configuration
rm -f ext/test-conf/openvox-ref-requested

case "$#" in
    0)
        # If no arguments provided, set OpenVox version to default
        puppet_ref="$(cat ext/test-conf/puppet-ref-default)"
        ;;
    1)
        # If one argument provided, set OpenVox version to that value
        puppet_ref="$1"
        echo "$puppet_ref" > ext/test-conf/openvox-ref-requested
        ;;
    *)
        # If more than one argument provided, exit with error status
        usage 1>&2
        exit 2
esac

# Install and update Ruby dependencies from top-level Gemfile
bundle config set --local path vendor/bundle
bundle config set --local without 'acceptance release'
bundle install --retry=10
bundle update
# Print out info on OpenVox dependency
bundle info openvox

# Symlink vendor/puppet to the git tree bundler checked out.  Use a
# relative path so that moving the pdb tree around won't break things.
cd vendor
# This will something like .../vendor/bundle/ruby/2.7.0/bundler/gems/puppet-ae5379e03311
# It is an OpenVox git repository installed by bundler
puppet_path="$(bundle info openvox --path)"
# Create a symlink at `vendor/puppet` that points to OpenVox repository
"$top/ext/bin/symlink-relative-to" "$puppet_path" puppet
